#!/usr/bin/env python3
"""mem — agent-memory 极简 CLI（ctx / s / add / cp / rm / clean）。

仅依赖标准库；与 Bridge (127.0.0.1:8765) 通信。
旧命令名（context/search/remember/checkpoint/forget/forget-batch）仍可用。
"""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

CONFIG_PATH = os.environ.get(
    "AGENT_MEMORY_CONFIG",
    str(Path.home() / "agent_memory" / "config.json"))
NO_PROXY_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))

TYPES = ["profile", "project", "decision", "task", "incident"]


def load_config() -> dict:
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        sys.exit(f"config error ({CONFIG_PATH}): {e}")


def api(cfg: dict, method: str, path: str, body: dict | None = None,
        timeout: int = 120) -> dict:
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        cfg["bridge_url"].rstrip("/") + path, data=data, method=method,
        headers={"Content-Type": "application/json",
                 "Authorization": "Bearer " + cfg["bridge_token"]})
    try:
        with NO_PROXY_OPENER.open(req, timeout=timeout) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        sys.exit(f"{method} {path} -> HTTP {e.code}: {e.read().decode()[:200]}")
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        sys.exit(f"bridge unreachable: {e}")


def project_id_for(path: str | None) -> str:
    cwd = os.path.abspath(os.path.expanduser(path or os.getcwd()))
    try:
        r = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"],
                           capture_output=True, text=True, timeout=10, check=True)
        url = r.stdout.strip()
        if url.startswith("git@"):
            url = url.split("git@", 1)[1]
        url = re.sub(r"^(ssh|https?|git)://", "", url)
        if "://" not in url and ":" in url.split("/", 1)[0]:
            url = url.replace(":", "/", 1)
        if url.endswith(".git"):
            url = url[:-4]
        return url.strip("/")
    except (subprocess.SubprocessError, OSError):
        pass
    root = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True, timeout=10)
    base = root.stdout.strip() if root.returncode == 0 else cwd
    return "local-" + hashlib.sha256(base.encode()).hexdigest()[:12]


def add_type_arg(sp):
    sp.add_argument("-t", "--type", default="decision", choices=TYPES)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="mem",
                                description="agent-memory：跨工具共享记忆")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("ctx", aliases=["context"], help="输出当前项目+全局记忆")
    sp.add_argument("--project")
    sp.add_argument("--global-only", action="store_true")
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("s", aliases=["search"], help="语义检索记忆")
    sp.add_argument("query")
    sp.add_argument("--project")
    sp.add_argument("-t", "--type", choices=TYPES)
    sp.add_argument("--status", default="active",
                    choices=["active", "superseded", "deprecated", "all"])
    sp.add_argument("--top-k", type=int, default=8)
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("add", aliases=["remember"], help="写入一条记忆")
    sp.add_argument("content")
    add_type_arg(sp)
    sp.add_argument("--scope", default="project", choices=["global", "project"])
    sp.add_argument("--project")
    sp.add_argument("--agent", default=os.environ.get("AGENT_NAME", "cli"))
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("cp", aliases=["checkpoint"], help="采集 git+产出，提取写回")
    sp.add_argument("--repo", default=".")
    sp.add_argument("--output-file")
    sp.add_argument("--agent", default=os.environ.get("AGENT_NAME", "cli"))
    sp.add_argument("--task-id")
    sp.add_argument("--started-at", help="会话起始时间（ISO），diff 归属过滤")
    sp.add_argument("--parallel", help="并行会话 agent 列表，逗号分隔")
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("rm", aliases=["forget"], help="删除一条记忆")
    sp.add_argument("memory_id")

    sp = sub.add_parser("clean", aliases=["forget-batch", "consolidate"],
                        help="语义整理：合并重复记忆（默认预览）")
    sp.add_argument("--project")
    sp.add_argument("--threshold", type=float, default=0.78)
    sp.add_argument("--max-groups", type=int, default=10)
    sp.add_argument("--scan", type=int, default=80)
    sp.add_argument("--apply", action="store_true", help="默认预览，加此参数才执行合并")
    sp.add_argument("--json", action="store_true")
    return p


def main() -> None:
    cfg = load_config()
    args = build_parser().parse_args()
    cmd = {"context": "ctx", "search": "s", "remember": "add",
           "checkpoint": "cp", "forget": "rm"}.get(args.cmd, args.cmd)

    if cmd == "ctx":
        pid = None if args.global_only else (args.project or project_id_for(None))
        out = api(cfg, "POST", "/context", {"project_id": pid})
        print(out["json"] if args.json else out["markdown"])
    elif cmd == "s":
        out = api(cfg, "POST", "/search", {
            "query": args.query, "project_id": args.project, "type": args.type,
            "status": args.status, "top_k": args.top_k})
        if args.json:
            print(json.dumps(out, ensure_ascii=False, indent=2))
            return
        for r in out["results"]:
            st = "" if (r.get("status") or "active") == "active" else f"[{r['status']}] "
            print(f"[{r.get('type') or '?'}|{r.get('project_id') or 'global'}] "
                  f"({r.get('score', 0):.2f}) {st}{r['text']}  id={r['id']}")
    elif cmd == "add":
        pid = args.project if args.scope == "project" else None
        if args.scope == "project" and not pid:
            pid = project_id_for(None)  # 从 cwd 的 git remote 自动推导
        out = api(cfg, "POST", "/remember", {
            "content": args.content, "type": args.type, "scope": args.scope,
            "project_id": pid, "source_agent": args.agent})
        print(json.dumps(out, ensure_ascii=False) if args.json
              else f"{out['status']}  id={out['id']}")
    elif cmd == "cp":
        text = ""
        if args.output_file:
            text = Path(os.path.expanduser(args.output_file)).read_text(errors="replace")
        out = api(cfg, "POST", "/checkpoint", {
            "repo_path": args.repo, "output_text": text,
            "source_agent": args.agent, "task_id": args.task_id,
            "started_at": args.started_at,
            "parallel_agents": args.parallel.split(",") if args.parallel else None})
        if args.json:
            print(json.dumps(out, ensure_ascii=False, indent=2))
            return
        print(f"project={out['project_id']} branch={out['branch']} "
              f"created={len(out['created'])} skipped={out['skipped']}")
        for item in out["created"]:
            print(f"  + [{item['type']}] {item['text'][:80]}")
    elif cmd == "rm":
        out = api(cfg, "DELETE", f"/memory/{args.memory_id}")
        print(json.dumps(out, ensure_ascii=False))
    elif cmd == "clean":
        out = api(cfg, "POST", "/consolidate", {
            "project_id": args.project, "threshold": args.threshold,
            "dry_run": not args.apply, "max_groups": args.max_groups,
            "scan": args.scan}, timeout=300)
        if args.json:
            print(json.dumps(out, ensure_ascii=False, indent=2))
            return
        mode = "已应用" if not out["dry_run"] else "预览（加 --apply 执行）"
        print(f"scanned={out['scanned']} groups={out['groups_found']} [{mode}]")
        for p in out["proposals"]:
            if "error" in p:
                print(f"  ! 提取失败: {p['error']}")
                continue
            print(f"  ↳ 合并 {len(p['ids'])} 条 → “{p['merged']}”  ({p['reason']})")
        if out.get("applied"):
            for a in out["applied"]:
                print(f"  ✓ new={a['new_id']} superseded={len(a['superseded'])} 条")


if __name__ == "__main__":
    main()
