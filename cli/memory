#!/usr/bin/env python3
"""memory CLI：codex / zcode / kimi / pi 等本地 agent 的共享记忆入口。

仅依赖标准库；与 Bridge (127.0.0.1:8765) 通信。
"""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

CONFIG_PATH = os.environ.get(
    "AGENT_MEMORY_CONFIG",
    str(Path.home() / "agent_memory" / "config.json"))
NO_PROXY_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def load_config() -> dict:
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        sys.exit(f"config error ({CONFIG_PATH}): {e}")


def call(cfg: dict, method: str, path: str, body: dict | None = None) -> dict:
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        cfg["bridge_url"].rstrip("/") + path, data=data, method=method,
        headers={"Content-Type": "application/json",
                 "Authorization": "Bearer " + cfg["bridge_token"]})
    try:
        with NO_PROXY_OPENER.open(req, timeout=120) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        sys.exit(f"bridge {method} {path} -> HTTP {e.code}: {e.read().decode()[:200]}")
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        sys.exit(f"bridge unreachable: {e}")


def project_id_for(path: str | None) -> str:
    cwd = os.path.abspath(os.path.expanduser(path or os.getcwd()))
    try:
        r = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"],
                           capture_output=True, text=True, timeout=10, check=True)
        url = r.stdout.strip()
        if url.startswith("git@"):
            url = url.split("git@", 1)[1]
        url = re.sub(r"^(ssh|https?|git)://", "", url)
        if "://" not in url and ":" in url.split("/", 1)[0]:
            url = url.replace(":", "/", 1)
        if url.endswith(".git"):
            url = url[:-4]
        return url.strip("/")
    except (subprocess.SubprocessError, OSError):
        pass
    root = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True, timeout=10)
    base = root.stdout.strip() if root.returncode == 0 else cwd
    return "local-" + hashlib.sha256(base.encode()).hexdigest()[:12]


def main() -> None:
    cfg = load_config()
    p = argparse.ArgumentParser(prog="memory")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("context", help="输出当前项目+全局记忆上下文")
    sp.add_argument("--project", help="project_id（默认从 cwd 的 git remote 推导）")
    sp.add_argument("--global-only", action="store_true", help="只要全局记忆")
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("search", help="语义检索记忆")
    sp.add_argument("query")
    sp.add_argument("--project")
    sp.add_argument("--type", choices=["profile", "project", "decision", "task", "incident"])
    sp.add_argument("--top-k", type=int, default=8)
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("remember", help="写入一条记忆")
    sp.add_argument("content")
    sp.add_argument("--type", default="decision",
                    choices=["profile", "project", "decision", "task", "incident"])
    sp.add_argument("--scope", default="project", choices=["global", "project"])
    sp.add_argument("--project")
    sp.add_argument("--agent", default=os.environ.get("AGENT_NAME", "cli"),
                    help="来源 agent 标识（codex/zcode/kimi/pi/human）")
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("checkpoint", help="收集 git 状态+会话产出，LLM 提取后写入")
    sp.add_argument("--repo", default=".")
    sp.add_argument("--output-file", help="agent 最终输出文本文件（可选）")
    sp.add_argument("--agent", default=os.environ.get("AGENT_NAME", "cli"))
    sp.add_argument("--task-id")
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("forget", help="删除一条记忆")
    sp.add_argument("memory_id")

    sp = sub.add_parser("forget-batch", help="按 scope 批量删除（污染应急）")
    sp.add_argument("--project")
    sp.add_argument("--type", choices=["profile", "project", "decision", "task", "incident"])
    sp.add_argument("--agent")
    sp.add_argument("--execute", action="store_true", help="默认 dry-run，加此参数才真删")

    args = p.parse_args()

    if args.cmd == "context":
        pid = None if args.global_only else (args.project or project_id_for(None))
        out = call(cfg, "POST", "/context", {"project_id": pid})
        print(out["json"] if args.json else out["markdown"])
    elif args.cmd == "search":
        out = call(cfg, "POST", "/search", {
            "query": args.query, "project_id": args.project,
            "type": args.type, "top_k": args.top_k})
        if args.json:
            print(json.dumps(out, ensure_ascii=False, indent=2))
            return
        for r in out["results"]:
            meta = f"[{r.get('type') or '?'}|{r.get('project_id') or 'global'}]"
            print(f"{meta} ({r.get('score', 0):.2f}) {r['text']}  id={r['id']}")
    elif args.cmd == "remember":
        pid = args.project if args.scope == "project" else None
        if args.scope == "project" and not pid:
            pid = project_id_for(None)  # 从 cwd 的 git remote 自动推导
        out = call(cfg, "POST", "/remember", {
            "content": args.content, "type": args.type, "scope": args.scope,
            "project_id": pid, "source_agent": args.agent})
        print(json.dumps(out, ensure_ascii=False) if args.json
              else f"{out['status']}  id={out['id']}")
    elif args.cmd == "checkpoint":
        text = ""
        if args.output_file:
            text = Path(os.path.expanduser(args.output_file)).read_text(errors="replace")
        out = call(cfg, "POST", "/checkpoint", {
            "repo_path": args.repo, "output_text": text,
            "source_agent": args.agent, "task_id": args.task_id})
        if args.json:
            print(json.dumps(out, ensure_ascii=False, indent=2))
            return
        print(f"project={out['project_id']} branch={out['branch']} "
              f"created={len(out['created'])} skipped={out['skipped']}")
        for item in out["created"]:
            print(f"  + [{item['type']}] {item['text'][:80]}")
    elif args.cmd == "forget":
        out = call(cfg, "DELETE", f"/memory/{args.memory_id}")
        print(json.dumps(out, ensure_ascii=False))
    elif args.cmd == "forget-batch":
        out = call(cfg, "POST", "/forget", {
            "project_id": args.project, "type": args.type,
            "source_agent": args.agent, "dry_run": not args.execute})
        print(json.dumps(out, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
