[Unit]
Description=agent-memory Bridge (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=__ROOT__/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8765 --app-dir __ROOT__/bridge
WorkingDirectory=__ROOT__
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
