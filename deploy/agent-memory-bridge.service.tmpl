[Unit]
Description=agent-memory Bridge (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=__HOME__/agent_memory/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8765 --app-dir __HOME__/agent_memory/bridge
WorkingDirectory=__HOME__/agent_memory
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
