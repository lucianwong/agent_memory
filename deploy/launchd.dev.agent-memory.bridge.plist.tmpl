<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.agent-memory.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>__ROOT__/.venv/bin/uvicorn</string>
        <string>server:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8765</string>
        <string>--app-dir</string>
        <string>__ROOT__/bridge</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__ROOT__/logs/bridge.out.log</string>
    <key>StandardErrorPath</key>
    <string>__ROOT__/logs/bridge.err.log</string>
</dict>
</plist>
